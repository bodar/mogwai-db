[submodule "vendor/tinkerpop"]
	path = vendor/tinkerpop
	url = https://github.com/apache/tinkerpop.git
	shallow = false
	# Pinned by SHA; its working tree carries build artifacts (node_modules,
	# bun.lock, generated grammar) we never track — ignore all working-tree state.
	ignore = all

[submodule "vendor/calcite"]
	path = vendor/calcite
	url = https://github.com/apache/calcite.git
	# READ-ONLY prior art for src/rel/ — never built, never imported, no Java toolchain
	# implied (same standing as tinkerpop's gremlin-core). Provisioned shallow+sparse by
	# scripts/init-submodule.sh; `shallow = true` so a stock `git submodule update` that
	# bypasses the script does not deepen the checkout to full history.
	shallow = true
	# In a linked worktree this path is a SYMLINK to the main checkout's copy (see
	# `share_from_main`), which git would otherwise report as a typechange against the
	# gitlink — ignore all working-tree state, as tinkerpop does.
	ignore = all

[submodule "vendor/gds"]
	path = vendor/gds
	url = https://github.com/neo4j/graph-data-science.git
	# READ-ONLY prior art for the graph-algorithm + barrier-substrate layer
	# (docs/2026-07-24-graph-algorithms-plan.md) — never built, never imported, no Java
	# toolchain implied (same standing as gremlin-core / calcite). Its `pregel` module is
	# the BSP/PregelSchema reference; `algo`/`algo-common` the implementations; `core` the
	# graph-projection model.
	# ⚠️ LICENSE: OpenGDS is GPLv3 (COPYLEFT), unlike the Apache-2.0 tinkerpop/calcite refs.
	# The gitlink commits only a SHA — mogwai-db distributes NO GPL bytes; the blobless+sparse
	# checkout materialises code in the local tree only. Study the algorithm/BSP STRUCTURE and
	# re-express in SQL; never transcribe GDS's Java code expression. Cite at the pin.
	# Provisioned shallow+sparse by scripts/init-submodule.sh, skipped under MOGWAI_SKIP_REFERENCE.
	shallow = true
	ignore = all
