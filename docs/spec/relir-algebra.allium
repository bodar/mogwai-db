-- allium: 3
-- relir-algebra.allium
--
-- Distilled from docs/2026-08-01-relir-build-plan.md (§2–§5) and src/rel/, src/channels.ts,
-- src/program.ts. It states the CONTRACT the algebra is built to, not the code's current shape:
-- where implementation and contract disagree, the disagreement is the finding.
--
-- Scope: the RelIR relational algebra — construction, verification, the pass pipeline, emission
-- and program execution.
-- Includes: Program/Binding/Reference, relation and statement nodes, the channel core and its
--   three policy tables, the checker's fail-closed laws, the declared passes, the two plan
--   budgets, the SELECT-block emitter, the binding executor's row transport.
-- Excludes:
--   - Gremlin semantics, shape, productivity, bulking as MEANING (resolved above this layer)
--   - the Step[] -> Rel lowering and spine routing (relir-migration.allium)
--   - the framing/wire layer, storage schema, the q kernel's internals
--   - the legacy spine (scheduled for deletion; see relir-migration.allium)

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum SqlType { int | real | text | blob | json | any }

-- What a carried column IS to the algebra, never what it means to Gremlin.
enum ChannelRole { alias | path | origin | branch_order | sack | from_v | encounter | bulk }

enum MergePolicy { union | pad | identical }
enum BarrierPolicy { consumed | empty | drop | keep }
enum GroupPolicy { combine | undefined_for_group }

enum NodeKind {
    scan | values | self_ref | ref
    | project | filter | aggregate | sort | limit | distinct | window | explode | materialize
    | join | union | recursive
}

-- What a node kind owes the carried channels. Total by construction: a new kind has no rule at
-- all until it declares one, and a dropped carried field is 33% of this repo's diagnosed defects.
enum ObligationClass {
    declares          -- sources and project: emit what you claim, nothing more
    | preserving      -- same channels in, same channels out
    | extending       -- input columns followed by the ones this node adds
    | reducing        -- aggregate: barrier, or grouped per-traverser reduction
    | merging         -- union: the declared peer merge of the arms
    | joining         -- join: one side's or the peer merge, and no rigid role from a nullable side
    | recursing       -- seed and step carry identical channels
}

enum JoinKind { inner | left | cross | semi | anti }
enum StatementKind { insert | update | delete }
enum PassKind { check | flatten | unroll | fuse | prune | land | name | recognize }

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Column {
    name: String
    sql_type: SqlType
    nullable: Boolean
}

value Channel {
    column: String
    role: ChannelRole
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract EmitterTotality {
    emit: (program: Program) -> EmittedProgram

    @invariant EveryKindHasAnArm
        -- The emitter is total over the node set: a node kind it cannot render is a
        -- COMPILE error, never a runtime throw. There is no fallback branch.

    @invariant NoSecondBindAuthority
        -- Composition happens in the kernel expression tree, so bind ordering is
        -- decided by exactly one render call. A rendered string spliced into another
        -- statement would be a second authority.

    @invariant OnlyDataSpendsAParameter
        -- A bound parameter is spent only on a value that came from the QUERY or the STORE.
        -- Text the compiler itself chose — the key of a JSON object it is constructing — is
        -- spelled inline. This is a budget obligation, not a micro-optimisation: the platform
        -- caps a statement at a hundred parameters, so a parameter spent on a compiler
        -- constant is the difference between a plan the routing seam admits and one it
        -- refuses. It also fixes the growth: the rendered bind count is a function of the DATA
        -- a plan carries, never of how many structural constants its emission happens to
        -- spell. Data must stay a parameter — inlining it would make the statement TEXT a
        -- function of the data, defeating both the statement cache and the text budget.

    @guidance
        -- The IR is normalised (one operator per node); SQL's SELECT is a composition of
        -- operators with fixed slots. Walk down from a node filling slots, and open a nested
        -- SELECT only where the slot needed is already occupied. Prior art: Calcite's
        -- RelToSqlConverter.
}

contract KernelAdditivity {
    render: (tree: KernelExpression) -> RenderedStatement

    @invariant AdditiveOnly
        -- The q kernel may GAIN a capability the emitter needs; nothing in it may be
        -- reshaped to suit RelIR, and its fail-closed properties (undefined hole throws,
        -- absent column throws) are preserved.
}

contract EquivalenceGate {
    compare: (relir_plan: Program, legacy_sql: RenderedStatement) -> EquivalenceVerdict

    @invariant SameResults
        -- Identical rows on the reference fixture for the traversal the plan came from.

    @invariant SameAccessPath
        -- Identical EXPLAIN QUERY PLAN, reduced to index DECISIONS with object names and
        -- CTE-materialisation lines dropped. This is the real content of "SQLite is the
        -- optimizer": it fails on a plan that reads the same and executes differently.

    @invariant SpellingIsNotAGate
        -- Byte-identical SQL is NOT required and must never be reintroduced. An unreachable
        -- gate invites a snapshot of the emitter against itself, which is what happened once.
}

contract RowTransport {
    carry: (rows: RetainedRows) -> KernelBind

    @invariant OneValueNeverNParameters
        -- A row set whose size is a function of DATA crosses the storage seam as ONE JSON
        -- value exploded by json_each, read or write. Measured on both runtimes: the JSON
        -- form is ~2x faster on the platform we ship to, and Durable Objects SQLite caps a
        -- statement at 100 bound parameters where the dev runtime caps at 65,535.

    @invariant DeclaredTypeIsTheAuthority
        -- Rows travel positionally against the binding's declared columns. No inference,
        -- no second type system; a value JSON cannot carry losslessly fails closed naming
        -- the column.
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The rendering substrate. Owned by src/sql/kernel; RelIR is a caller, not an author.
external entity KernelExpression {}
external entity KernelBind {}
external entity RenderedStatement {
    sql: String
    bind_count: Integer
    text_bytes: Integer
}
external entity EquivalenceVerdict {
    same_results: Boolean
    same_access_path: Boolean
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One authority per channel role, and the totality of these three policies is the whole reason
-- they are tables rather than conditionals.
entity ChannelPolicy {
    role: ChannelRole
    merge: MergePolicy
    barrier: BarrierPolicy
    grouping: GroupPolicy

    -- The COLUMN a channel of this role occupies, and a FOURTH totality for the same reason as the
    -- three policies above: the type is a property of the role, never a choice made at the site
    -- that happened to build the relation.
    column_type: SqlType
    column_nullable: Boolean

    -- A role a fork cannot reconcile: per-traverser physical state.
    is_rigid: merge = identical
    -- What survives a global barrier. Nothing does today, and that is a DERIVATION.
    survives_barrier: barrier = keep
    -- Whether a grouping by traverser identity has a defined answer for this role.
    survives_grouping: grouping = combine
}

entity RelNode {
    kind: NodeKind
    obligation: ObligationClass
    inputs: List<RelNode>
    columns: List<Column>
    channels: List<Channel>

    -- A node exists only if a named kind factory minted it: local shape validated, result
    -- frozen, construction brand attached. A spread of an existing node is not a node.
    minted_by_factory: Boolean

    -- Sources answer for themselves; everything else answers to its inputs.
    is_source: kind in {scan, values, self_ref, ref}
    is_barrier: obligation = reducing and channels.count = 0

    invariant EveryClaimedChannelIsEmitted {
        channels.all(c => columns.any(col => col.name = c.column))
    }

    invariant DeclaredColumnNamesAreUnique {
        for a in columns:
            for b in columns:
                a != b implies a.name != b.name
    }

    invariant OnlyProjectDeclaresChannels {
        obligation = declares implies kind in {scan, values, self_ref, ref, project}
    }

    invariant SourcesHaveNoInputs {
        is_source implies inputs.count = 0
    }

    -- The categorical difference from the refuted typed-core IR: shape is resolved above this
    -- layer, so a node has no Gremlin type field. A ChannelRole is per-COLUMN carried-state
    -- bookkeeping, never the stream's Gremlin type.
    invariant NoGremlinTypeVocabulary {
        columns.all(col => col.sql_type in {int, real, text, blob, json, any})
    }
}

entity JoinNode {
    node: RelNode
    left: RelNode
    right: RelNode
    join_kind: JoinKind
    has_on_predicate: Boolean

    -- A join emits its sides' columns POSITIONALLY (the left alone for semi/anti), so its
    -- declared width is what makes a column reference against it resolvable at all.
    expected_width: if join_kind in {semi, anti}: left.columns.count
                    else: left.columns.count + right.columns.count

    invariant SidesAreDistinctRelations {
        left != right
    }

    invariant DeclaredWidthMatchesEmission {
        node.columns.count = expected_width
    }

    invariant OnPredicateWhereSqlRequiresOne {
        (join_kind in {inner, left} implies has_on_predicate)
            and (join_kind = cross implies not has_on_predicate)
    }
}

entity AggregateNode {
    node: RelNode
    group_keys: Integer
    aggregates: Integer
    is_grouped: group_keys > 0

    -- TWO contracts, not one. A BARRIER emits a new traverser and no channel can honestly
    -- survive it. A grouping by the traverser's own IDENTITY emits one row per surviving
    -- traverser, so its channels must come out the other side or a later reducer counts the
    -- collapse away. The node declares which it is; the checker proves it is allowed to be.
    is_reduction: is_grouped and node.channels.count > 0

    invariant OutputIsKeysThenAggregates {
        node.columns.count = group_keys + aggregates
    }

    invariant AReductionCarriesOnlyGroupableRoles {
        is_reduction implies node.channels.all(c => groupable(c.role))
    }
}

entity RecursiveNode {
    node: RelNode
    cte_name: String
    seed: RelNode
    step: RelNode
    self_references_in_step: Integer
    self_reference_is_top_level_from: Boolean
    step_contains_aggregate: Boolean
    step_contains_window: Boolean

    -- SQLite's recursive-term law, measured rather than assumed: the rule is POSITIONAL, not a
    -- reference count. Wrapping the self reference in a derived table fails even as the sole
    -- reference. Correlated scalar subqueries against it are legal.
    invariant SelfReferenceAppearsExactlyOnce {
        self_references_in_step = config.recursive_self_references_allowed
    }

    invariant SelfReferenceIsAtTopLevelOfFrom {
        self_reference_is_top_level_from
    }

    invariant NoAggregateInRecursiveTerm {
        not step_contains_aggregate
    }

    invariant NoWindowInRecursiveTerm {
        not step_contains_window
    }

    -- The CTE header requirement, and the check that catches a body which forgot a carried
    -- column while still declaring it.
    invariant SeedAndStepAgreeOnColumns {
        seed.columns.count = step.columns.count
    }
}

entity Statement {
    kind: StatementKind
    target: RelNode
    source: RelNode?
    returning: List<Column>
    columns: List<Column>

    -- A statement's RESULT is a relation like any other, so `columns` IS the RETURNING schema.
    -- A separate returning type was the same fact spelled twice, and it is deleted.
    invariant ResultTypeIsTheReturningSchema {
        columns.count = returning.count
    }

    -- The one physical-schema node is the scan, so a mutation target is a typed scan rather
    -- than a bare table name. There is no place left for a hardcoded column name.
    invariant TargetIsAScan {
        target.kind = scan
    }

    invariant InsertSourceArityMatchesTargetColumns {
        kind = insert implies source != null
    }

    -- Membership in another relation is an ordinary predicate over a scope holding the target.
    -- A dedicated `using` field had to name its own key, and that is how a physical 'id'
    -- reached the emitter.
    @invariant MembershipIsAPredicate
        -- Deletion by membership is expressed as a subquery predicate in `where`,
        -- never as a dedicated field.
}

entity Binding {
    name: String
    position: Integer
    relation: RelNode?
    statement: Statement?

    -- A relation binding whose rows are TAKEN rather than re-derived: the value it held at THIS
    -- point in the program. A CTE is recomputed by every step that names it, which is invisible
    -- in a read program and is the vertex-drop cascade's whole failure mode in one with effects —
    -- the target relation reads edges an earlier statement has already deleted, so the vertex
    -- delete matches nothing and leaves vertices standing.
    snapshot: Boolean

    is_statement_boundary: statement != null

    -- The ONE question that decides both how a reference to this binding renders and whether it
    -- is a step of its own. A statement is retained by what it IS — its rows cannot be recomputed
    -- at all — so `snapshot` says of a relation exactly what a statement says of itself.
    is_retained: is_statement_boundary or snapshot

    -- How many of the program's steps READ this binding, transitively: a CTE naming another CTE
    -- puts both inside the same statement. The walk stops at a retained binding, whose rows a
    -- reader takes as a bind rather than recomputing.
    reading_steps: Integer

    -- A named CTE and a prior statement's result are the SAME CONCEPT: a reference to a
    -- relation computed earlier. Two mechanisms for it is why the write path read as a second
    -- machine.
    invariant ABindingIsEitherARelationOrAStatement {
        (relation != null and statement = null) or (relation = null and statement != null)
    }

    -- There is nothing to snapshot about an effect: a statement's rows are retained by what the
    -- statement is, and marking it would be the same fact spelled twice.
    invariant OnlyARelationIsSnapshotted {
        snapshot implies relation != null
    }
}

-- The one naming mechanism, and the reason there is no With node and no naming side table.
entity Reference {
    name: String
    holder: Binding
    resolves_to: Binding?
    declared_columns: List<Column>

    invariant ReferenceResolves {
        resolves_to != null
    }

    invariant ReferenceResolvesToAnEarlierBinding {
        resolves_to != null implies resolves_to.position < holder.position
    }

    invariant ReferenceTypeMatchesItsBinding {
        resolves_to != null and resolves_to.relation != null
            implies declared_columns.count = resolves_to.relation.columns.count
    }
}

-- THE TOP OF A PLAN IS A PROGRAM, NOT A TREE. Ordering IS the bindings list; there is no node
-- that privately owns execution order.
entity Program {
    bindings: List<Binding>
    result: RelNode
    stage: assembled | checked | emitted | executed | refused

    -- TWO counts of one budget, and they are not equal. `bind_occurrences` is over IR
    -- occurrences; `rendered_binds` is over the emitted bind list, and a fused block can spell
    -- one literal more than once. Whoever DECIDES on the budget must measure the same quantity
    -- the refusal measures, or the decision is taken on a number that is not the wall.
    bind_occurrences: Integer
    rendered_binds: Integer? when stage = emitted | executed
    statement_text_bytes: Integer? when stage = emitted | executed
    refusal_reason: RefusalReason? when stage = refused

    steps: EmittedStep with program = this
    statement_bindings: bindings where is_statement_boundary
    retained_bindings: bindings where is_retained

    within_bind_budget: bind_occurrences <= config.do_bind_cap
    is_read_only: statement_bindings.count = 0

    -- A RE-EVALUATED CTE IS A DIFFERENT QUESTION ONCE SOMETHING HAS BEEN WRITTEN, and this is what
    -- makes the snapshot obligatory rather than remembered. Reached through ONE step a CTE is still
    -- exactly right, so the law names the hazard and nothing wider. It is a CHECK failure and not a
    -- refusal, and the distinction is the same one the decline contract draws: an unlowered step is
    -- coverage we do not have, but a plan whose answer depends on which statement ran first is a
    -- bug in whatever built it.
    invariant ARelationReadByTwoStepsOfAProgramWithEffectsIsSnapshotted {
        statement_bindings.count > 0
            implies bindings.all(b => b.is_retained or b.reading_steps <= 1)
    }

    transitions stage {
        assembled -> checked
        assembled -> refused
        checked -> emitted
        checked -> refused
        emitted -> executed
        terminal: executed, refused
    }
}

enum RefusalReason { bind_budget | statement_text_budget | unrenderable_row_value | recursive_term_illegal }

-- A pass is Rel -> Rel, total, and ORDER-DECLARED. The order is a property of the pipeline, not
-- of whichever caller happens to invoke one.
entity Pass {
    kind: PassKind
    order: Integer

    -- A pass that exists but is not in the pipeline is a pass that does not run.
    in_live_pipeline: Boolean

    invariant EveryDeclaredPassRunsOnTheLiveRoute {
        in_live_pipeline
    }
}

entity EmittedStep {
    program: Program
    position: Integer
    binding: Binding?
    rendered: RenderedStatement
    is_result: Boolean

    invariant RenderedBindsWithinPlatformCap {
        rendered.bind_count <= config.do_bind_cap
    }

    invariant RenderedTextWithinPlatformCap {
        rendered.text_bytes <= config.do_statement_text_cap
    }
}

-- A retained binding's rows, held by the executor — a statement's RETURNING, or the SELECT of a
-- relation the program snapshotted. The retention is not an optimisation: it is the pre-mutation
-- snapshot a vertex-drop cascade requires. Re-evaluating the source after an earlier delete asks a
-- different question of a graph that has changed.
entity RetainedRows {
    binding: Binding
    row_count: Integer
    all_values_json_transportable: Boolean

    -- Retention follows `is_retained`, not statement-hood: the executor cannot tell the two apart,
    -- and neither can a later reference.
    invariant RetainedOnlyForRetainedBindings {
        binding.is_retained
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Durable Objects SQLite, measured. The dev runtime's cap is 65,535, which is why a bind
    -- list sized by row count passes every test and fails only in production.
    do_bind_cap: Integer = 100
    do_statement_text_cap: Integer = 100_000
    recursive_self_references_allowed: Integer = 1
    -- The corpus maximum for a bounded repeat is 10; the ceiling exists so a hand-written
    -- times(1000) degrades honestly rather than emitting unbounded statement text.
    unroll_replication_ceiling: Integer = 100
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

-- A label's value is a path HISTORY rather than a reference, so the column is a JSON array of
-- tagged entries — and NULL on a row that reached here along a path which bound nothing.
default ChannelPolicy alias_policy = {
    role: alias, merge: union, barrier: consumed, grouping: undefined_for_group,
    column_type: json, column_nullable: true
}
-- Either regime: per-position rowids on a linear walk, one array on a recursive one. JSON is the
-- honest declaration for whichever arrives first.
default ChannelPolicy path_policy = {
    role: path, merge: pad, barrier: drop, grouping: undefined_for_group,
    column_type: json, column_nullable: true
}
default ChannelPolicy origin_policy = {
    role: origin, merge: identical, barrier: empty, grouping: undefined_for_group,
    column_type: int, column_nullable: false
}
default ChannelPolicy branch_order_policy = {
    role: branch_order, merge: identical, barrier: empty, grouping: undefined_for_group,
    column_type: int, column_nullable: false
}
-- A per-traverser scalar of whatever its seed was, so its storage class is not knowable here.
default ChannelPolicy sack_policy = {
    role: sack, merge: identical, barrier: drop, grouping: undefined_for_group,
    column_type: any, column_nullable: true
}
default ChannelPolicy from_v_policy = {
    role: from_v, merge: identical, barrier: drop, grouping: undefined_for_group,
    column_type: int, column_nullable: true
}
default ChannelPolicy encounter_policy = {
    role: encounter, merge: identical, barrier: drop, grouping: combine,
    column_type: int, column_nullable: false
}
default ChannelPolicy bulk_policy = {
    role: bulk, merge: identical, barrier: drop, grouping: combine,
    column_type: int, column_nullable: false
}

-- These record the pipeline AS BUILT, which is why three of them violate
-- `EveryDeclaredPassRunsOnTheLiveRoute`: `fuse`, `prune` and `land` exist, are tested, and are
-- reachable from no production caller. `land` is the load-bearing one: it is the declared remedy
-- for a row set sized by DATA, and while it is unwired the remedy in force is a DECLINE at the
-- routing seam instead — which keeps the wall out of production and puts that whole class of
-- traversal permanently on the route this migration exists to delete.
default Pass check_pass  = { kind: check,     order: 1, in_live_pipeline: true }
default Pass flatten_pass = { kind: flatten,  order: 2, in_live_pipeline: false }
default Pass unroll_pass = { kind: unroll,    order: 3, in_live_pipeline: false }
default Pass fuse_pass   = { kind: fuse,      order: 4, in_live_pipeline: false }
default Pass prune_pass  = { kind: prune,     order: 5, in_live_pipeline: false }
default Pass land_pass   = { kind: land,      order: 6, in_live_pipeline: false }
default Pass name_pass   = { kind: name,      order: 7, in_live_pipeline: true }
default Pass recognize_pass = { kind: recognize, order: 8, in_live_pipeline: false }

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- CONSTRUCTION -------------------------------------------------------------

rule MintRelation {
    when: MintRelation(kind, columns, channels, inputs)

    requires: columns.count > 0
    requires: channels.all(c => columns.any(col => col.name = c.column))

    ensures: RelNode.created(
        kind: kind,
        obligation: obligation_for(kind),
        inputs: inputs,
        columns: columns,
        channels: channels,
        minted_by_factory: true
    )

    @guidance
        -- Factories take named objects, validate local shape and freeze the result. A rewriter
        -- rebuilds through the kind factory; a spread can retain an obsolete field or lose the
        -- construction brand. SelfRef has no public factory: only Recursive supplies it.
}

rule RefuseUnmintedNode {
    when: CheckProgram(program)
    requires: program.bindings.any(b => b.relation != null and not b.relation.minted_by_factory)
    ensures: program.stage = refused
    ensures: ConstructionRefused(program: program)
}

-- VERIFICATION -------------------------------------------------------------

-- The fail-closed verifier, and the first thing built. It is the whole-plan equivalent of the
-- framing layer's column assertion: scope resolution, expression placement, the channel
-- obligations, the SQLite laws and the two budgets.
rule CheckProgram {
    when: CheckProgram(program)

    requires: program.stage = assembled
    requires: program.bindings.all(b => b.relation != null or b.statement != null)
    requires: program.within_bind_budget

    ensures: program.stage = checked

    @guidance
        -- Bindings are checked IN ORDER against the bindings declared before them, so a forward
        -- or self reference fails closed rather than resolving by accident. The ordering the
        -- executor relies on is the ordering the checker proved.
}

rule RefuseOverBindBudget {
    when: CheckProgram(program)
    requires: program.stage = assembled
    requires: not program.within_bind_budget
    ensures: program.stage = refused
    ensures: program.refusal_reason = bind_budget
    ensures: BudgetRefused(program: program, budget: bind_budget)

    @guidance
        -- Fail closed rather than emit SQL that only fails in production. The remedy is the
        -- `land` pass, which must therefore run BEFORE this refusal is reachable on any route
        -- that can produce a data-sized row set.
}

-- Every node kind answers for the carried channels, and the table that says how is TOTAL: a new
-- kind fails the build until its obligation is declared. These four rules are the obligations a
-- node-local factory check cannot state, because each needs more than the node itself.

rule CheckJoinObligation {
    when: node: JoinNode.created
    requires: node.node.channels.count > 0
    ensures: JoinObligationChecked(node: node)

    @guidance
        -- A join's channels must be one side's or the peer merge of both. An unmatched left-join
        -- row has the right side entirely NULL, and a rigid role arriving nullable is not the
        -- per-traverser physical state it claims to be: that is an error, never a coercion.
}

rule CheckAggregateObligation {
    when: node: AggregateNode.created
    ensures: AggregateObligationChecked(node: node)

    @guidance
        -- Declaring no channels is a BARRIER and the barrier contract applies. Declaring the
        -- input's channels is a per-traverser REDUCTION, legal only where every role has a
        -- defined answer when N rows become one. Anything else is neither — and neither is what
        -- a dropped carried field looks like. WHICH aggregate suits a role is Gremlin semantics
        -- and stays above this layer.
}

rule CheckRecursiveTermLegality {
    when: node: RecursiveNode.created
    ensures: RecursiveTermChecked(node: node)

    @guidance
        -- A body that cannot be made legal throws a clear deferral NAMING why; it never
        -- silently mis-executes. Flattening is the pass that makes broader bodies legal, and
        -- the vocabulary SQLite really permits inside a recursive term is far wider than a
        -- hand-written body gate allows: anti-joins, derived unions, IN subqueries, left joins
        -- with the walk on the left, correlated scalar subqueries and multi-hop join chains.
        -- What is NOT expressible at any lowering is a per-iteration barrier: DISTINCT is inert
        -- there, and LIMIT is a global cap on the whole walk.
}

rule ResolveReference {
    when: reference: Reference.created
    requires: reference.resolves_to != null
    ensures: ReferenceResolved(reference: reference)

    @guidance
        -- One concept, one node: a reference to a re-derivable relation binding is a named CTE,
        -- and a reference to a RETAINED one — a statement, or a snapshotted relation — is its rows
        -- carried as one JSON bind. Asking "CTE or materialise?" once, of one concept, is the point.
}

-- LOWERING PASSES ----------------------------------------------------------

rule ApplyFuse {
    when: ApplyPass(program, fuse)
    ensures: SemanticRewritesApplied(program: program, pass: fuse)

    @guidance
        -- Adjacent filters conjoin; Distinct over Distinct collapses; Limit over Limit
        -- composes; a Sort dead before a barrier goes. Sort+Limit is NOT this pass's job —
        -- that is one SELECT's ORDER BY ... LIMIT and belongs to the emitter's block assembler.
        -- Every rewrite must re-point column references, including inside correlated subplans.
}

rule ApplyPrune {
    when: ApplyPass(program, prune)
    ensures: UnobservedColumnsDropped(program: program)

    @guidance
        -- Load-bearing rather than cosmetic: it is what makes unroll's replicated subplans
        -- affordable and removes carried columns a barrier already consumed. The plan is a DAG,
        -- so a node's need is the UNION over its consumers, to a fixpoint — pruning a shared
        -- node to what one parent reads breaks the other.
}

rule ApplyLand {
    when: ApplyPass(program, land)

    ensures:
        if every_oversized_row_set_is_literal(program):
            OversizedRowSetsLanded(program: program)
        else:
            -- It declines what it cannot carry rather than guessing, and the budget then fails
            -- closed on it — never silently mis-executed.
            LandDeclined(program: program)
            program.refusal_reason = unrenderable_row_value

    @guidance
        -- An over-budget literal row set becomes ONE JSON bind exploded by json_each and
        -- re-projected positionally. A pass and not an emitter behaviour: emit never learns
        -- about chunking, and the rewritten plan is an ordinary plan the checker verifies.
        -- A row holding anything but a literal has no compile-time JSON, so the pass declines
        -- it and the budget fails closed on it.
}

rule FenceAClauseReader {
    when: FenceClauseReader(program, reader)
    ensures: BoundaryHintPlaced(program: program, at: reader)

    @guidance
        -- Neither WHERE nor ORDER BY can name a select alias, so a filter or sort fused into the
        -- block that computes its subject RE-INLINES the whole projection. Measured: 25 / 45 / 65
        -- binds for one, two and three range predicates against a legacy 2 / 3 / 4, and 24 for one
        -- ordering against legacy's 1 — a fourth predicate exceeds the platform cap where legacy
        -- answers. A boundary hint lands the CTE-then-read shape and makes the growth linear.
        -- Only the FIRST reader needs one, structurally: a later one already sits over a
        -- boundary the assembler refuses to fuse into.
}

rule ApplyName {
    when: ApplyPass(program, name)
    ensures: SharedNodesBoundToNames(program: program)

    @guidance
        -- Decide named CTE versus inlined derived table for every shared node, honouring an
        -- explicit materialisation hint and never colliding with a caller's chosen name. The
        -- policy is applied once with the whole plan visible instead of at every construction
        -- site. A pass upstream that rebuilds per parent occurrence makes every share count 1
        -- and silently turns this analysis off.
}

-- EMISSION -----------------------------------------------------------------

rule EmitProgram {
    when: EmitProgram(program)

    requires: program.stage = checked

    ensures:
        for binding in program.bindings:
            EmittedStep.created(
                program: program,
                position: binding.position,
                binding: binding,
                rendered: render_binding(binding),
                is_result: false
            )
    ensures: program.stage = emitted
}

rule RefuseEmissionOverRenderedBindCap {
    when: EmitProgram(program)
    requires: program.stage = checked
    requires: program.rendered_binds != null
    requires: program.rendered_binds > config.do_bind_cap
    ensures: program.stage = refused
    ensures: program.refusal_reason = bind_budget

    @guidance
        -- The RENDERED bind list is the authority, not the static count: a fused block can
        -- spell one literal more than once, and the static count is over IR occurrences.
}

rule RefuseEmissionOverStatementTextCap {
    when: EmitProgram(program)
    requires: program.stage = checked
    requires: program.statement_text_bytes != null
    requires: program.statement_text_bytes > config.do_statement_text_cap
    ensures: program.stage = refused
    ensures: program.refusal_reason = statement_text_budget

    @guidance
        -- The second budget the plan owns. Replication multiplies plan size, so the pass that
        -- replicates consults the rendered size and declines above the ceiling, falling back to
        -- a recursive term which then refuses a barrier body as a clean deferral.
}

-- EXECUTION ----------------------------------------------------------------

rule RunProgram {
    when: RunProgram(program)

    requires: program.stage = emitted

    ensures:
        for step in program.steps:
            StepExecuted(program: program, step: step)
    ensures: program.stage = executed

    @guidance
        -- Walk the bindings in order. A plain relation binding is already a CTE in the SQL of
        -- every step after it; a RETAINED binding — a statement, or a snapshotted relation — is a
        -- step whose rows are kept, and every later reference to it resolves to those rows. The
        -- executor lives outside the algebra: an executor inside it rebuilds write as a special
        -- case in a new layer.
}

rule RetainStepResult {
    when: StepExecuted(program, step)
    requires: step.binding != null
    requires: step.binding.is_retained
    ensures: RetainedRows.created(
        binding: step.binding,
        row_count: rows_returned(step),
        all_values_json_transportable: json_transportable(rows_returned(step))
    )
}

rule FailClosedOnUntransportableRow {
    when: rows: RetainedRows.created
    requires: not rows.all_values_json_transportable
    ensures: TransportRefused(binding: rows.binding)

    @guidance
        -- JSON carries null, numbers, strings and booleans losslessly and nothing else. A blob
        -- or a value outside that set fails closed NAMING the column: the wrong answer here
        -- would be silent, and a deferral is not.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneAuthorityPerChannelRole {
    for a in ChannelPolicies:
        for b in ChannelPolicies:
            a != b implies a.role != b.role
}

invariant NoChannelSurvivesAGlobalBarrier {
    for policy in ChannelPolicies:
        policy.barrier != keep
}

-- A carried column's declared TYPE is a function of its role, and the node-local channel obligations
-- cannot state this: they check column NAMES and channel membership, never storage class. So a node
-- may declare a channel column as one type and emit another, and nothing above notices — the
-- direction in which "every claimed channel is emitted" is satisfied while the schema is still
-- wrong. It was one storage class chosen at every construction site, which was true only while every
-- carried channel was a rowid or a counter.
invariant AChannelColumnIsTypedByItsRole {
    for node in RelNodes:
        node.channels.all(c =>
            ChannelPolicies.any(p => p.role = c.role
                and node.columns.any(col => col.name = c.column
                    and col.sql_type = p.column_type
                    and col.nullable = p.column_nullable)))
}

invariant EmittedProgramsAreWithinTheBindBudget {
    for program in Programs:
        program.stage in {emitted, executed} implies program.bind_occurrences <= config.do_bind_cap
}

invariant EmittedProgramsAreWithinTheStatementTextBudget {
    for program in Programs:
        program.stage in {emitted, executed}
            implies program.statement_text_bytes <= config.do_statement_text_cap
}

-- The budget a CALLER is refused on must be the budget the emitter enforces. A caller admitted on
-- the IR-occurrence count and refused on the rendered count is admitted on a number that is not
-- the wall, and the refusal then lands where the caller can no longer choose another route.
invariant TheAdmittedCountAndTheEnforcedCountAgree {
    for program in Programs:
        program.rendered_binds != null
            implies program.rendered_binds <= program.bind_occurrences
}

invariant BindingNamesAreUnique {
    for a in Bindings:
        for b in Bindings:
            a != b implies a.name != b.name
}

invariant ExecutionOrderIsTheBindingOrder {
    for step in EmittedSteps:
        step.binding != null implies step.position = step.binding.position
}

invariant ARefusedProgramNamesItsReason {
    for program in Programs:
        program.stage = refused implies program.refusal_reason != null
}

invariant PassPipelineOrderIsUnique {
    for a in Passes:
        for b in Passes:
            a != b implies a.order != b.order
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RelationalAlgebra {
    exposes:
        NodeKind
        ObligationClass
        ChannelRole

    provides:
        MintRelation(kind, columns, channels, inputs)
        CheckProgram(program)
        ApplyPass(program, pass)
        FenceClauseReader(program, reader)
        EmitProgram(program)
        RunProgram(program)

    contracts:
        demands KernelAdditivity
        fulfils EmitterTotality
        fulfils RowTransport

    @guarantee ClosedNodeSet
        -- Adding a node kind requires showing the seam cannot EXPRESS a shape, never that
        -- it has not been HANDED one. No opaque escape node wrapping foreign SQL exists —
        -- not as a bridge, not temporarily, not behind a flag.

    @guarantee StructuralOnly
        -- Fusion, partition keys, pruning, legality and naming. No cost model, no
        -- statistics, no join reordering: SQLite is the optimizer, and a mid-end that costs
        -- plans duplicates its work. Out of scope permanently, not merely for now.

    @guarantee EffectsOnlyAtABinding
        -- Relation positions are pure, so a statement cannot be a join input. This is a
        -- type-level fact rather than a checker rule, and it is what makes a write in a read
        -- position plan composition instead of a row-at-a-time loop.

    @guidance
        -- The clean-room rule is a VOCABULARY boundary: the algebra imports the neutral
        -- channel core and nothing Gremlin. A node cannot know what a sack is.
}

