{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mogwai-db",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-07-01",
  // nodejs_compat: the reused GraphBinary serializers use node's Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "GRAPH", "class_name": "GraphDatabase" },
      // The singleton control-plane registry for ongoing replication (src/cloudflare/replicator-registry-do.ts,
      // §9·2). One instance per deployment (a fixed id); a data store the worker-residency scheduler reads —
      // it never runs a replication, so it never busy-locks a graph.
      { "name": "REPLICATOR", "class_name": "ReplicatorRegistryDO" }
    ]
  },
  // Where io() reads and writes whole-graph documents (src/cloudflare/R2IoStore.ts). Read INSIDE the
  // Durable Object — a binding is a property of a DO's env exactly as it is a Worker's — so a
  // whole-graph read/write happens where the graph lives and only bytes cross a seam.
  //
  // OPTIONAL by design: `Env.IO` is `R2Bucket | undefined`, and with the binding removed io() fails
  // closed naming it (NO_IO_STORE) rather than silently doing nothing. Declared here so `wrangler dev`
  // provisions a LOCAL bucket, which is what lets the shared runtime contract exercise the R2 half of
  // the seam on workerd instead of only the filesystem half on Bun.
  "r2_buckets": [{ "binding": "IO", "bucket_name": "mogwai-io" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GraphDatabase"] },
    { "tag": "v2", "new_sqlite_classes": ["ReplicatorRegistryDO"] }
  ],

  // The replication scheduler's periodic wake (§9): a Worker Cron Trigger fires `scheduled()`, which runs
  // the due replication jobs at WORKER residency (a client of the graph DOs) — deliberately NOT a DO alarm,
  // which would occupy a graph DO's single-threaded slot. Every minute (the finest cron granularity); a job's
  // own `checkpoint_interval` paces how often it actually re-pulls. A one-shot `POST /_replicate` and the
  // admin `POST /_scheduler/run` are unaffected.
  "triggers": { "crons": ["* * * * *"] },

  // Outbound-HTTP host allowlist for io()/federate over HTTP (src/config.ts, src/http-allowlist.ts).
  // The URL in `g.io("https://…")` / `federate("https://…")` comes from a client's query, so it is
  // confined to these hosts — an SSRF guard. UNSET (as here) ⇒ outbound HTTP is DISABLED (deny all,
  // fail closed). To permit hosts, uncomment ONE of:
  //   "vars": { "HTTP_ALLOWLIST": "backup.example,peer.internal" }
  // or the structured form (same shape the Bun config uses), which also carries PATH_PREFIX etc.:
  //   "vars": { "CONFIG": { "httpAllowlist": ["backup.example", "peer.internal"], "pathPrefix": "gremlin" } }
  "vars": {}
}
