{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM + DOM.Iterable + WebWorker are here for the BROWSER leaf (src/browser/*): OPFS
    // (FileSystemDirectoryHandle, navigator.storage), Worker, and Web Locks (navigator.locks) are DOM
    // globals; the Service Worker edge's FetchEvent / ServiceWorkerGlobalScope / Client(s) are WebWorker
    // globals. Each was measured at ZERO added errors against the bun + workers-types set (they layer
    // cleanly, and skipLibCheck covers the .d.ts), so one lib list still type-checks all targets. lib is
    // type-only — it changes nothing at runtime, where per-target bundling selects the real globals. A
    // Service Worker file casts `self` to `ServiceWorkerGlobalScope` (the WebWorker type) since the
    // ambient `self` cannot be that specific scope under a shared lib set.
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["bun", "@cloudflare/workers-types"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Beyond `strict`, and free on this tree — each measured at 0 errors before being enabled.
    // These are CORRECTNESS checks, so they apply everywhere, generated `parser/` included.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "isolatedModules": true,

    // The UNUSED-CODE checks (noUnusedLocals, noUnusedParameters, verbatimModuleSyntax) are NOT
    // here — `mise run lint` passes them on the command line, over src/test/scripts only.
    //
    // Why not here: generated `parser/` fails 24 of them (unused `Token`/`int` imports, unused
    // `previousContext` locals, a value-position type import) and must never be hand-edited
    // (locked decision 2). That count is per-generator, not fixed — it was 16 until the GQL
    // sub-language parser landed and added 8, which is why `scripts/lint.ts` filters by DIRECTORY
    // and prints the tally rather than asserting a number. There is NO config-level way to exempt
    // it — all measured:
    //   - `include`/`exclude` only filter the ROOT set. An imported file is still checked with the
    //     root config's flags, so parser/ returns via src/gremlin/frontend.ts.
    //   - project references would scope it, but `composite` REQUIRES emit (TS6310) and this
    //     project is noEmit by design — Bun and Wrangler consume the TS directly.
    //   - a workspace or `link:` package does not help: tsc resolves the symlink back to the real
    //     path, and even a REAL copy under node_modules/ is still linted. `skipLibCheck` covers
    //     `.d.ts` only; there is no source equivalent.
    // So the exemption lives in the INVOCATION, which is `mise run lint`.
    //
    // Measured but NOT enabled anywhere yet — each is a project, not a flag flip:
    //   exactOptionalPropertyTypes          95 errors / 37 files
    //   noPropertyAccessFromIndexSignature 782 errors / 48 files  (style, not safety)
    //   noUncheckedIndexedAccess          1367 errors / 71 files  (highest value of the three)
    // Re-measure with: tsc --noEmit --<flag> true

    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "test-browser", "parser", "scripts"]
}
