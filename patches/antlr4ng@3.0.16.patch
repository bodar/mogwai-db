    */
   isPrecedenceDfa;
   /**
-   * A mapping from an ATNConfigSet hash to a DFAState.
-   * Used to quick look up the DFA state for a particular configuration set.
+   * A mapping from an ATNConfigSet hash to the DFA states whose configuration sets carry that
+   * hash. Each entry is a bucket because a 32-bit hash is not injective; buckets are
+   * disambiguated with DFAState.equals so a state is only returned for the configuration set it
+   * was computed from. Conflating two different sets makes the simulator follow the wrong
+   * decision, surfacing as a spurious "no viable alternative", and because the DFA is shared
+   * across parses such a state persists for the life of the process.
    */
   states = /* @__PURE__ */ new Map();
+  stateCount = 0;
   constructor(atnStartState, decision) {
